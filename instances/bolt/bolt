#!/bin/sh
# bolt: launch the bolt agent in a sandboxed container.
#
# Thin POSIX-sh launcher: sets AGENT_ROOT (this instance's directory) and
# hands off to the shared 'agentic-workspace launch' command. Plain sh on
# purpose, so only uv is required on the host.
SELF=$0
case $SELF in
    */*) ;;
    *) SELF=$(command -v -- "$SELF" 2>/dev/null || echo "$SELF") ;;
esac
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF") || break
    case $LINK in
        /*) SELF=$LINK ;;
        *) SELF=$(dirname "$SELF")/$LINK ;;
    esac
done
AGENT_ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
export AGENT_ROOT
ROOT=$(CDPATH= cd -- "$AGENT_ROOT/../.." && pwd)

exec "$ROOT/agentic-workspace" launch "$@"
