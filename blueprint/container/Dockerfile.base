FROM ubuntu:26.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Pinned tool versions, refreshed by `./agentic-workspace update` into
# blueprint/container/versions.json (clone-local, gitignored) and passed as
# build args. Docker freezes a RUN layer until its command text changes, so
# the pins are what actually moves a tool: a changed version busts the layer
# cache for that step. Empty args (fresh clone, no versions.json) fall back
# to resolving "latest" at build time. Reference args only as ${NAME} or
# ${NAME:-fallback} - the Apptainer def converter textually substitutes them
# (see dockerfile_to_def.py --build-arg).
# (see dockerfile_to_def.py --build-arg). The *_SHA256 args are refreshed
# together with the versions and carry per-arch checksums
# "amd64=<hex>,arm64=<hex>" for the direct downloads: verified after
# download when present, loudly skipped when not. Tools installed through
# npm/uv are integrity-verified by the package manager itself.
ARG NODE_VERSION=""
ARG YQ_VERSION=""
ARG GH_VERSION=""
ARG TYPST_VERSION=""
ARG UV_VERSION=""
ARG BUN_VERSION=""
ARG OPENCODE_VERSION=""
ARG CLAUDE_CODE_VERSION=""
ARG CODEX_VERSION=""
ARG PI_VERSION=""
ARG NODE_SHA256=""
ARG YQ_SHA256=""
ARG GH_SHA256=""
ARG TYPST_SHA256=""
ARG UV_SHA256=""
ARG BUN_SHA256=""

# Basic setup + CLI utilities
RUN apt-get update && apt-get install -y \
        --no-install-recommends \
        curl \
        git \
        git-lfs \
        openssh-client \
        ca-certificates \
        build-essential \
        gosu \
        jq \
        ripgrep \
        python3 \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) node_arch="x64" ;; \
        arm64) node_arch="arm64" ;; \
        *) echo "Unsupported architecture for Node.js: $arch" >&2; exit 1 ;; \
    esac \
    && node_version="${NODE_VERSION:-$(curl -fsSL https://nodejs.org/dist/index.json | jq -r --arg node_arch "$node_arch" 'map(select(.files | index("linux-" + $node_arch))) | .[0].version')}" \
    && curl -fsSL "https://nodejs.org/dist/${node_version}/node-${node_version}-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz \
    && node_sha="$(printf '%s\n' "${NODE_SHA256}" | tr ',' '\n' | sed -n "s/^${node_arch}=//p")" \
    && if [ -n "$node_sha" ]; then printf '%s  %s\n' "$node_sha" /tmp/node.tar.xz | sha256sum -c -; else echo "warning: node downloaded without a checksum pin" >&2; fi \
    && mkdir -p /opt/node \
    && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1 \
    && ln -sf /opt/node/bin/node /usr/local/bin/node \
    && ln -sf /opt/node/bin/npm /usr/local/bin/npm \
    && ln -sf /opt/node/bin/npx /usr/local/bin/npx \
    && rm -f /tmp/node.tar.xz

RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) yq_arch="amd64" ;; \
        arm64) yq_arch="arm64" ;; \
        *) echo "Unsupported architecture for yq: $arch" >&2; exit 1 ;; \
    esac \
    && yq_version="${YQ_VERSION:-$(curl -fsSL https://api.github.com/repos/mikefarah/yq/releases/latest | jq -r '.tag_name | ltrimstr("v")')}" \
    && curl -fsSL "https://github.com/mikefarah/yq/releases/download/v${yq_version}/yq_linux_${yq_arch}" -o /usr/local/bin/yq \
    && yq_sha="$(printf '%s\n' "${YQ_SHA256}" | tr ',' '\n' | sed -n "s/^${yq_arch}=//p")" \
    && if [ -n "$yq_sha" ]; then printf '%s  %s\n' "$yq_sha" /usr/local/bin/yq | sha256sum -c -; else echo "warning: yq downloaded without a checksum pin" >&2; fi \
    && chmod +x /usr/local/bin/yq

RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) gh_arch="amd64" ;; \
        arm64) gh_arch="arm64" ;; \
        *) echo "Unsupported architecture for gh: $arch" >&2; exit 1 ;; \
    esac \
    && gh_version="${GH_VERSION:-$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest | jq -r '.tag_name | ltrimstr("v")')}" \
    && curl -fsSL "https://github.com/cli/cli/releases/download/v${gh_version}/gh_${gh_version}_linux_${gh_arch}.tar.gz" -o /tmp/gh.tar.gz \
    && gh_sha="$(printf '%s\n' "${GH_SHA256}" | tr ',' '\n' | sed -n "s/^${gh_arch}=//p")" \
    && if [ -n "$gh_sha" ]; then printf '%s  %s\n' "$gh_sha" /tmp/gh.tar.gz | sha256sum -c -; else echo "warning: gh downloaded without a checksum pin" >&2; fi \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && install -m 0755 "/tmp/gh_${gh_version}_linux_${gh_arch}/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh.tar.gz "/tmp/gh_${gh_version}_linux_${gh_arch}"

RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) typst_arch="x86_64" ;; \
        arm64) typst_arch="aarch64" ;; \
        *) echo "Unsupported architecture for Typst: $arch" >&2; exit 1 ;; \
    esac \
    && typst_version="${TYPST_VERSION:-$(curl -fsSL https://api.github.com/repos/typst/typst/releases/latest | jq -r '.tag_name | ltrimstr("v")')}" \
    && curl -fsSL "https://github.com/typst/typst/releases/download/v${typst_version}/typst-${typst_arch}-unknown-linux-musl.tar.xz" -o /tmp/typst.tar.xz \
    && typst_sha="$(printf '%s\n' "${TYPST_SHA256}" | tr ',' '\n' | sed -n "s/^${typst_arch}=//p")" \
    && if [ -n "$typst_sha" ]; then printf '%s  %s\n' "$typst_sha" /tmp/typst.tar.xz | sha256sum -c -; else echo "warning: typst downloaded without a checksum pin" >&2; fi \
    && tar -xJf /tmp/typst.tar.xz -C /tmp \
    && install -m 0755 "/tmp/typst-${typst_arch}-unknown-linux-musl/typst" /usr/local/bin/typst \
    && rm -rf /tmp/typst.tar.xz "/tmp/typst-${typst_arch}-unknown-linux-musl"

# uv: pinned release tarball, checksum-verified when a pin is present
# (the plain installer resolves latest, unverified).
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) uv_arch="x86_64" ;; \
        arm64) uv_arch="aarch64" ;; \
        *) echo "Unsupported architecture for uv: $arch" >&2; exit 1 ;; \
    esac \
    && if [ -n "$UV_VERSION" ]; then \
        curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${uv_arch}-unknown-linux-gnu.tar.gz" -o /tmp/uv.tar.gz \
        && uv_sha="$(printf '%s\n' "${UV_SHA256}" | tr ',' '\n' | sed -n "s/^${uv_arch}=//p")" \
        && if [ -n "$uv_sha" ]; then printf '%s  %s\n' "$uv_sha" /tmp/uv.tar.gz | sha256sum -c -; else echo "warning: uv downloaded without a checksum pin" >&2; fi \
        && tar -xzf /tmp/uv.tar.gz -C /tmp \
        && install -m 0755 "/tmp/uv-${uv_arch}-unknown-linux-gnu/uv" /usr/local/bin/uv \
        && install -m 0755 "/tmp/uv-${uv_arch}-unknown-linux-gnu/uvx" /usr/local/bin/uvx \
        && rm -rf /tmp/uv.tar.gz "/tmp/uv-${uv_arch}-unknown-linux-gnu"; \
    else \
        curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_UNMANAGED_INSTALL="/usr/local/bin" sh; \
    fi

# bun: pinned release asset (fallback: latest tag from the GitHub API).
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) bun_arch="x64" ;; \
        arm64) bun_arch="aarch64" ;; \
        *) echo "Unsupported architecture for bun: $arch" >&2; exit 1 ;; \
    esac \
    && bun_version="${BUN_VERSION:-$(curl -fsSL https://api.github.com/repos/oven-sh/bun/releases/latest | jq -r '.tag_name | ltrimstr("bun-v")')}" \
    && curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${bun_version}/bun-linux-${bun_arch}.zip" -o /tmp/bun.zip \
    && bun_sha="$(printf '%s\n' "${BUN_SHA256}" | tr ',' '\n' | sed -n "s/^${bun_arch}=//p")" \
    && if [ -n "$bun_sha" ]; then printf '%s  %s\n' "$bun_sha" /tmp/bun.zip | sha256sum -c -; else echo "warning: bun downloaded without a checksum pin" >&2; fi \
    && unzip -q /tmp/bun.zip -d /tmp \
    && install -m 0755 "/tmp/bun-linux-${bun_arch}/bun" /usr/local/bin/bun \
    && rm -rf /tmp/bun.zip "/tmp/bun-linux-${bun_arch}"

RUN npm install -g \
        "opencode-ai@${OPENCODE_VERSION:-latest}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION:-latest}" \
        "@openai/codex@${CODEX_VERSION:-latest}" \
    && npm install -g --ignore-scripts \
        "@earendil-works/pi-coding-agent@${PI_VERSION:-latest}" \
    && npm cache clean --force

# pi-plan-modus: read-only "plan mode" extension for pi instances.
# Baked into the image (with its runtime dep just-bash) so every pi instance
# gets it without a per-instance install or runtime network access. The
# entrypoint copies the extension source into ~/.pi/agent/extensions/ and
# links this node_modules so just-bash resolves (pi's extension discovery
# needs real files, but node module resolution follows the symlink).
RUN mkdir -p /opt/pi-extensions/plan-modus \
    && npm install --prefix /opt/pi-extensions/plan-modus \
        --omit=dev --legacy-peer-deps --ignore-scripts pi-plan-modus@0.2.6 \
    && npm cache clean --force

# agentic subagent extension + pi-notify + default agent definitions. Baked
# into the base image (no runtime network access needed). The entrypoint copies
# the extensions into ~/.pi/agent/extensions/ and the agents into
# ~/.pi/agent/agents/ for auto-discovery by pi. Directory COPYs keep all these
# small files in a single layer instead of one layer each (fewer intermediate
# images, faster builds).
RUN mkdir -p /opt/pi-extensions/agents
COPY extensions/ /opt/pi-extensions/
COPY agents/ /opt/pi-extensions/agents/

ENV PATH="/opt/node/bin:/usr/local/bin:$PATH"

# The CLIs above are pinned at build time and /opt/node is not writable
# by the container's runtime user, so an in-place self-update can only
# fail ("no write permission to npm prefix"). Upgrades come from
# rebuilding the image.
ENV DISABLE_AUTOUPDATER=1
ENV OPENCODE_DISABLE_AUTOUPDATE=1

# Create home directory for container
RUN mkdir -p /home
ENV HOME=/home

WORKDIR /workspace

COPY entrypoint.py /entrypoint.py

ENTRYPOINT ["/entrypoint.py"]
